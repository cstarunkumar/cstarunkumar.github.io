---
layout: default
---
<div class="post">
  <header class="post-header mb-4">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description text-muted mb-3">{{ page.description }}</p>
    {% endif %}

    <div class="note-toolbar d-flex flex-wrap align-items-center justify-content-between py-2 border-top border-bottom" style="border-color: var(--global-divider-color) !important;">
      <div class="note-meta text-muted small my-1">
        {% if page.course %}
          <span class="badge badge-info mr-2">{{ page.course }}</span>
        {% endif %}
        {% if page.category %}
          <span class="badge badge-secondary mr-2">{{ page.category }}</span>
        {% endif %}
        {% if page.date %}
          <span><i class="fa-regular fa-calendar mr-1"></i>{{ page.date | date: "%B %d, %Y" }}</span>
        {% endif %}
      </div>

      <div class="note-downloads my-1 d-flex align-items-center">
        {% if page.pdf %}
          <a href="{{ page.pdf | relative_url }}" class="btn btn-sm btn-outline-primary mr-2" download target="_blank" title="Download PDF document">
            <i class="fa-solid fa-file-pdf mr-1"></i> Download PDF
          </a>
        {% else %}
          <button onclick="window.print()" class="btn btn-sm btn-outline-primary mr-2" title="Print or save page as PDF">
            <i class="fa-solid fa-file-pdf mr-1"></i> Download / Print PDF
          </button>
        {% endif %}

        {% if page.tex %}
          <a href="{{ page.tex | relative_url }}" class="btn btn-sm btn-outline-secondary" download target="_blank" title="Download LaTeX source">
            <i class="fa-solid fa-file-code mr-1"></i> Download TeX
          </a>
        {% else %}
          <button onclick="downloadNoteTex()" class="btn btn-sm btn-outline-secondary" title="Export LaTeX source">
            <i class="fa-solid fa-file-code mr-1"></i> Download TeX
          </button>
        {% endif %}
      </div>
    </div>
  </header>

  <article class="note-content">
    {{ content }}
  </article>

  <div class="mt-5 pt-3 border-top" style="border-color: var(--global-divider-color) !important;">
    <a href="{{ '/notes/' | relative_url }}" class="btn btn-sm btn-outline-secondary">
      <i class="fa-solid fa-arrow-left mr-1"></i> Back to Notes
    </a>
  </div>
</div>

<script>
function downloadNoteTex() {
  const title = {{ page.title | jsonify }};
  const article = document.querySelector('.note-content');
  const bodyText = article ? article.innerText : '';
  const texDoc = `\\documentclass{article}
\\usepackage{amsmath, amssymb}
\\usepackage{geometry}
\\geometry{margin=1in}

\\title{${title}}
\\author{Tarun Kumar}
\\date{\\today}

\\begin{document}
\\maketitle

% Note Content:
${bodyText.replace(/\\/g, '\\textbackslash{}').replace(/%/g, '\\%')}

\\end{document}
`;
  const blob = new Blob([texDoc], { type: 'text/x-tex;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.tex`;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}
</script>
